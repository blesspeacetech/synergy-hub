# Site URL used for canonical URLs, OG tags, sitemap, and SEO
# Set to your production domain (no trailing slash)
VITE_SITE_URL=https://arichiglobalsynergy.com

# Nitro preset for deployment target
# node-server (default, for Node/Docker/Azure Container Apps), vercel, cloudflare-module, netlify, aws-lambda
# NITRO_PRESET=node-server

# Optional: Port for production server (node-server preset)
PORT=3000
HOST=0.0.0.0

# Optional: Add email provider keys for contact form in production
# RESEND_API_KEY=
# SENDGRID_API_KEY=
